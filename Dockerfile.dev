# syntax=docker/dockerfile:1.7
# =============================================================================
# DEVELOPMENT / DEMO IMAGE — NOT FOR PRODUCTION.
#
# This image bakes the in-memory test configuration, the stub verification
# transport (fixed code 123456), the test CAPTCHA provider, and self-signed
# test TLS certificates so a single `docker run` yields a working demo with
# no external dependencies. It deliberately runs in development mode (no
# `mode: production`), so the fail-closed security gate is NOT active.
#
# For production use the top-level `Dockerfile`, which ships no secrets and
# requires a mounted `mode: production` config.
# =============================================================================
FROM golang:1.27.4-bookworm AS builder

WORKDIR /app

COPY go.mod go.sum ./

# See the top-level Dockerfile for why the four `COPY --from=go-*` lines are
# gone and what replaced them: go.mod carries no local-path replaces, so those
# contexts fed nothing and only made this image unbuildable by `make
# docker-build-dev`, which supplies no such contexts. First-party modules
# resolve from Gitea with the credentials mounted here as a BuildKit secret
# (dependency-resolution.md §6); the mount is optional so the build still works
# where no secret is supplied.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then . /run/secrets/gomodauth; fi; \
    go mod download

COPY . .

ARG BUILD_TAGS="fido2"
RUN CGO_ENABLED=0 GOOS=linux go build -tags "${BUILD_TAGS}" -ldflags="-s -w" -o /signald ./cmd/signald/

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /signald /usr/local/bin/signald
COPY configs/signal-server.yml /etc/signal-server/config.yml
# Test TLS material generated by `make test-tls` (docker-build-dev and the
# integration target run it first); none of it is committed.
COPY test/tls/server-cert.pem /etc/signal-server/tls/server-cert.pem
COPY test/tls/server-key.pem /etc/signal-server/tls/server-key.pem
COPY test/tls/ca-cert.pem /etc/signal-server/tls/ca-cert.pem

RUN sed -i 's|tlsCertFile: ""|tlsCertFile: "/etc/signal-server/tls/server-cert.pem"|' /etc/signal-server/config.yml && \
    sed -i 's|tlsKeyFile: ""|tlsKeyFile: "/etc/signal-server/tls/server-key.pem"|' /etc/signal-server/config.yml

EXPOSE 8081 8443

ENTRYPOINT ["signald"]
CMD ["start", "--config", "/etc/signal-server/config.yml"]
