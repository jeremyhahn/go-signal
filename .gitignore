# Build artifacts. Anchored to the repo root: an unanchored "build/" matches
# ANY directory named build at any depth, which silently swallowed the
# test/build package (the Makefile-target tests) when it was added.
/build/
bin/
coverage/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Config (secrets)
configs/secrets*.yml
configs/local*.yml
*.env
.env.*

# Dependencies
vendor/
go.work
go.work.sum

# compiled binaries and node_modules never enter the module tree
/signald
/key-transparency
/registration-service
/svr2
/storage-service
node_modules/
