# syntax=docker/dockerfile:1.7
# Builds the signald chat-server binary. See deploy/Dockerfile.shared
# for the rationale behind the multi-stage layout.
FROM golang:1.26.6-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux \
    go build -trimpath -ldflags="-s -w" \
      -o /out/signald ./cmd/signald

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/signald /usr/local/bin/signald
USER nonroot:nonroot
EXPOSE 8080 8443
ENTRYPOINT ["/usr/local/bin/signald"]
CMD ["start"]
