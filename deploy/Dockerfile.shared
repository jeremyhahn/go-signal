# Reference only (Docker has no include): per-binary Dockerfiles follow this pattern.
# Build: golang alpine, go mod download with cache mounts, CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/${BIN} ./cmd/${BIN}.
# Run: gcr.io/distroless/static-debian12:nonroot, USER nonroot:nonroot, ENTRYPOINT /usr/local/bin/${BIN}, CMD start.
