# syntax=docker/dockerfile:1.7
FROM golang:1.27.4-bookworm AS builder

# SERVICE selects which ./cmd/<service> entry point to compile.
# Valid values: cdsi, svr2, key-transparency, registration-service, storage-service
ARG SERVICE
ARG BUILD_TAGS="fido2"

WORKDIR /app

COPY go.mod go.sum ./

# See the top-level Dockerfile for why the four `COPY --from=go-*` lines are
# gone and what replaced them: go.mod carries no local-path replaces, so those
# contexts fed nothing and only made every `make docker-build-services` target
# fail at the first COPY. First-party modules resolve from Gitea with the
# credentials mounted here as a BuildKit secret (dependency-resolution.md §6);
# the mount is optional so the build still works where no secret is supplied.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then . /run/secrets/gomodauth; fi; \
    go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux \
    go build -tags "${BUILD_TAGS}" -ldflags="-s -w" \
    -o /service "./cmd/${SERVICE}/"

# Runtime: minimal Debian image with no dev toolchain.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /service /usr/local/bin/service

# Run as a non-root system user. The service binary expects its config
# to be mounted at /etc/signal-service/config.yml at deploy time; no
# secrets or active configuration are baked into this image.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin signal \
    && mkdir -p /etc/signal-service \
    && chown -R signal:signal /etc/signal-service
USER signal

ENTRYPOINT ["/usr/local/bin/service"]
CMD ["start"]
